# ADB over TCP port 5555 without a key, like gw4-wifi-recovery: anyone on
# the network gets a shell (and root through Magisk su), so the network is
# the access control. Remove this file from the overlay to turn it off.
on property:sys.boot_completed=1
    exec_background u:r:magisk:s0 root root -- /system/bin/sh ${MAGISKTMP}/adb-tcp.sh ${MAGISKTMP}
