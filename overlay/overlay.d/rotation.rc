# accelerometer_rotation turns itself back on (written by system_server with
# the default value 1, not by the user), and a round watch face should not
# rotate. The setting can only be written once SettingsProvider runs, so
# this waits for boot_completed.
on property:sys.boot_completed=1
    exec_background u:r:magisk:s0 root root -- /system/bin/settings put system accelerometer_rotation 0
