# The One UI 6 system partition carries ifxdhd.ko (Wi-Fi) and lcd.ko in
# /lib/modules, built for the stock kernel. This kernel rejects them
# (module_layout CRC), so the modules built with it are bind-mounted over
# them before macloader loads the Wi-Fi driver. macloader starts with
# class main, about 10 s after 'fs', so the script runs in the background
# instead of holding up init.
on fs
    exec_background u:r:magisk:s0 root root -- /system/bin/sh ${MAGISKTMP}/kmod.sh ${MAGISKTMP}
