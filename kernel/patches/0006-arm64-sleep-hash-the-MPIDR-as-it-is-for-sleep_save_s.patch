From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jakub Mendyka <jkmendyka@gmail.com>
Date: Mon, 23 Nov 2026 05:45:21 +0100
Subject: [PATCH 6/7] arm64: sleep: hash the MPIDR as it is for
 sleep_save_stash

The Samsung 4.19 __cpu_suspend_enter and _cpu_resume shift a
multithreading MPIDR right by 8 before computing the sleep_save_stash
index, which matched the rev1 device tree (cpu reg 0x0, 0x1). With
bootloader rev2 the device tree carries the real MPIDRs (0x0, 0x100),
the hash mask is built from them, and the shifted MPIDR of both cores
lands in the same slot. With both cores in C2 one of them resumed with
the other's saved context and the system hung until the watchdog reset
it.

The MPIDR is now used as it is, as in mainline and in the 5.15 kernel.
---
 arch/arm64/kernel/sleep.S | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/kernel/sleep.S b/arch/arm64/kernel/sleep.S
index 152e9f8..05955f7 100755
--- a/arch/arm64/kernel/sleep.S
+++ b/arch/arm64/kernel/sleep.S
@@ -74,13 +74,16 @@ ENTRY(__cpu_suspend_enter)
 	mov	x2, sp
 	str	x2, [x0, #SLEEP_STACK_DATA_SYSTEM_REGS + CPU_CTX_SP]
 
-	/* find the mpidr_hash */
+	/*
+	 * find the mpidr_hash; the MPIDR is used as it is, as in mainline:
+	 * the hash mask comes from the device tree cpu reg values, which on
+	 * bootloader rev2 are the real MPIDRs (0x0, 0x100). Shifting a
+	 * multithreading MPIDR right by 8 (as for the rev1 device tree with
+	 * 0x0, 0x1) would put both cores in the same sleep_save_stash slot,
+	 * and with both cores in C2 one would resume with the other's context.
+	 */
 	ldr_l	x1, sleep_save_stash
 	mrs	x7, mpidr_el1
-	tst	x7, #MPIDR_MT_BITMASK
-	b.eq	1f
-	lsr	x7, x7, #MPIDR_LEVEL_BITS
-1:
 	adr_l	x9, mpidr_hash
 	ldr	x10, [x9, #MPIDR_HASH_MASK]
 	/*
@@ -114,11 +117,8 @@ ENDPROC(cpu_resume)
 	.popsection
 
 ENTRY(_cpu_resume)
+	/* the MPIDR as it is, see __cpu_suspend_enter */
 	mrs	x1, mpidr_el1
-	tst	x1, #MPIDR_MT_BITMASK
-	b.eq	1f
-	lsr	x1, x1, #MPIDR_LEVEL_BITS
-1:
 	adr_l	x8, mpidr_hash		// x8 = struct mpidr_hash virt address
 
 	/* retrieve mpidr_hash members to compute the hash */
