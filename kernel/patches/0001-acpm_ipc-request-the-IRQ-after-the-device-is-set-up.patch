From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jakub Mendyka <jkmendyka@gmail.com>
Date: Sun, 22 Nov 2026 15:56:46 +0100
Subject: [PATCH 1/2] acpm_ipc: request the IRQ after the device is set up

The rev2 bootloader leaves an APM interrupt pending, so the handler ran
before acpm_ipc->intr was mapped and faulted at NULL+INTSR1. Request it
at the end of probe, as the 5.15 driver does.
---
 drivers/soc/samsung/acpm/acpm_ipc.c | 26 ++++++++++++++++----------
 1 file changed, 16 insertions(+), 10 deletions(-)

diff --git a/drivers/soc/samsung/acpm/acpm_ipc.c b/drivers/soc/samsung/acpm/acpm_ipc.c
index 09f3b5346..0ff0158b9 100755
--- a/drivers/soc/samsung/acpm/acpm_ipc.c
+++ b/drivers/soc/samsung/acpm/acpm_ipc.c
@@ -931,16 +931,6 @@ static int acpm_ipc_probe(struct platform_device *pdev)
 
 	acpm_ipc->irq = irq_of_parse_and_map(node, 0);
 
-	ret = devm_request_threaded_irq(&pdev->dev, acpm_ipc->irq, acpm_ipc_irq_handler,
-			acpm_ipc_irq_handler_thread,
-			IRQF_ONESHOT,
-			dev_name(&pdev->dev), acpm_ipc);
-
-	if (ret) {
-		dev_err(&pdev->dev, "failed to register acpm_ipc interrupt:%d\n", ret);
-		return ret;
-	}
-
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	acpm_ipc->intr = devm_ioremap_resource(&pdev->dev, res);
 	if (IS_ERR(acpm_ipc->intr))
@@ -979,6 +969,22 @@ static int acpm_ipc_probe(struct platform_device *pdev)
 				msecs_to_jiffies(acpm_debug->period));
 	}
 
+	/*
+	 * Request the interrupt only after the registers, SRAM and channels
+	 * are set up: the APM firmware may already have an interrupt pending
+	 * (it does with the rev2 bootloader), and the handler dereferences
+	 * acpm_ipc->intr and the channel table.
+	 */
+	ret = devm_request_threaded_irq(&pdev->dev, acpm_ipc->irq, acpm_ipc_irq_handler,
+			acpm_ipc_irq_handler_thread,
+			IRQF_ONESHOT,
+			dev_name(&pdev->dev), acpm_ipc);
+
+	if (ret) {
+		dev_err(&pdev->dev, "failed to register acpm_ipc interrupt:%d\n", ret);
+		return ret;
+	}
+
 	dev_info(&pdev->dev, "acpm_ipc probe Done!\n");
 	return ret;
 }
