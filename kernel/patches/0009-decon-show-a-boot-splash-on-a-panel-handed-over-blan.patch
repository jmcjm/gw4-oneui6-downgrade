From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jakub Mendyka <jkmendyka@gmail.com>
Date: Mon, 23 Nov 2026 22:00:00 +0100
Subject: [PATCH] decon: show a boot splash on a panel handed over blank

Bootloader rev2 (R870XXS2JZG3) blanks the rm69091 panel before it
starts the kernel, and with the MCD panel driver decon_initial_display()
sends nothing to the panel: it expects the bootloader logo to stay on.
The screen stays black for about 20 s, until the first frame of the
boot animation.

With CONFIG_EXYNOS_DECON_BOOT_SPLASH, decon draws a power symbol into
its framebuffer and, if a panel is connected, takes the generic
initial-display path of the non-MCD case: window and DPP set to the
framebuffer, decon start, panel display on, one frame. The panel keeps
the image in its own memory (command mode) until SurfaceFlinger sends
the next frame. The panel init sequence (TE on, sleep out) has already
run in the dsim probe, so the frame gets its TE; the waits on this
path only log a timeout.

The bootloader leaves window 1 enabled on channel 1, with the physical
address of its own buffer (0x9e0cf000 in the fault below) in DPP1. The
DPU SysMMU is already translating (sysmmu,hold-rpm-on-boot) and has no
mapping for it, so a frame with that window enabled ends in a fatal
SysMMU page fault:

  From [G0, G1, VG], SysMMU READ PAGE FAULT at 0x9e0cf000
  DATA_PATH_CONTROL_0 = 0x11 (windows 0 and 1), _1 = 0x10 (win1 -> ch1)

Every window other than the default one is therefore disabled before
the frame. The default window reads only the framebuffer, mapped at
probe into the same SysMMU (decon_map_ion_handle() on the dsim device,
the owner of 13820000.sysmmu). The first HWC frame programs every
window again.

The option defaults to y; adding EXYNOS_DECON_BOOT_SPLASH to
kernel/nouh.config turns it off.
---
--- a/drivers/video/fbdev/exynos/dpu30/decon_core.c
+++ b/drivers/video/fbdev/exynos/dpu30/decon_core.c
@@ -3585,6 +3585,46 @@
 		framebuffer_release(win->fbinfo);
 }
 
+#if IS_ENABLED(CONFIG_EXYNOS_DECON_BOOT_SPLASH)
+static inline int decon_splash_clamp(int v)
+{
+	return v < 0 ? 0 : (v > 16 ? 16 : v);
+}
+
+/*
+ * Draws a power symbol (a ring open at the top and a vertical bar), light
+ * grey on black, into a 32 bpp buffer. Coordinates are in 1/16 pixel for a
+ * one pixel antialiased edge. All four bytes of a pixel get the same value,
+ * so the result does not depend on the channel order of the format.
+ */
+static void decon_boot_splash_draw(u32 *px, int w, int h)
+{
+	int s = min(w, h), cx = w / 2, cy = h / 2;
+	int r = s * 16 * 8 / 45;	/* ring radius */
+	int hw = s * 16 * 7 / 450;	/* half stroke width */
+	int gap = hw * 3;		/* clearance of the opening */
+	int yt = -(r + hw), yb = -(r / 5);	/* ends of the bar */
+	int x, y, X, Y, d, c, b, e, dy;
+
+	for (y = 0; y < h; y++) {
+		Y = (y - cy) * 16 + 8;
+		for (x = 0; x < w; x++, px++) {
+			X = (x - cx) * 16 + 8;
+			d = int_sqrt(X * X + Y * Y);
+			c = decon_splash_clamp(hw - abs(d - r) + 8);
+			if (c && Y < 0) {
+				/* distance to the 45 degree edge of the opening */
+				e = ((abs(X) + Y) * 181) >> 8;
+				c = c * decon_splash_clamp(e - gap + 8) / 16;
+			}
+			dy = Y < yt ? Y - yt : (Y > yb ? Y - yb : 0);
+			b = decon_splash_clamp(hw - (int)int_sqrt(X * X + dy * dy) + 8);
+			*px = (max(c, b) * 0xe0 / 16) * 0x01010101U;
+		}
+	}
+}
+#endif
+
 static int decon_fb_alloc_memory(struct decon_device *decon, struct decon_win *win)
 {
 	struct exynos_panel_info *lcd_info = decon->lcd_info;
@@ -3637,6 +3677,9 @@
 			memset(vaddr + i + 3, 0, 1);
 		}
 	}
+#if IS_ENABLED(CONFIG_EXYNOS_DECON_BOOT_SPLASH)
+	decon_boot_splash_draw(vaddr, lcd_info->xres, lcd_info->yres);
+#endif
 
 	fbi->screen_base = vaddr;
 
@@ -4229,9 +4272,26 @@
 					decon->id, connected ? "connected" : "detached",
 					decon_get_bypass_cnt_global(decon->id));
 		}
+#if IS_ENABLED(CONFIG_EXYNOS_DECON_BOOT_SPLASH)
+		/*
+		 * The panel driver has just run the full init sequence (TE on,
+		 * sleep out), but the panel memory holds nothing: bootloader
+		 * rev2 blanks the panel before the kernel starts. Send the
+		 * framebuffer once, like the non-MCD path below does, so the
+		 * splash stays on the panel until the first frame of
+		 * SurfaceFlinger.
+		 */
+		if (connected > 0) {
+			decon_info("%s: boot splash\n", __func__);
+			goto boot_splash;
+		}
+#endif
 		goto decon_init_done;
 	}
 #endif
+#if IS_ENABLED(CONFIG_MCD_PANEL) && IS_ENABLED(CONFIG_EXYNOS_DECON_BOOT_SPLASH)
+boot_splash:
+#endif
 	memset(&win_regs, 0, sizeof(struct decon_window_regs));
 	win_regs.wincon = wincon(decon->dt.dft_win);
 	win_regs.start_pos = win_start_pos(0, 0);
@@ -4280,6 +4340,24 @@
 	
 	decon_reg_set_window_control(decon->id, decon->dt.dft_win,
 			&win_regs, is_colormap);
+#if IS_ENABLED(CONFIG_EXYNOS_DECON_BOOT_SPLASH)
+	/*
+	 * Bootloader rev2 leaves other windows enabled (window 1 on
+	 * channel 1) with DMA addresses of its own buffer, programmed
+	 * while the DPU SysMMU was bypassed. They are not mapped in the
+	 * kernel's page table, so the frame below would fetch them and
+	 * fault (fatal SysMMU page fault). Only the default window, which
+	 * reads the mapped framebuffer, stays enabled. The first HWC frame
+	 * sets every window anyway.
+	 */
+	{
+		int win;
+
+		for (win = 0; win < decon->dt.max_win; win++)
+			if (win != decon->dt.dft_win)
+				decon_reg_set_win_enable(decon->id, win, 0);
+	}
+#endif
 
 	decon_reg_all_win_shadow_update_req(decon->id);
 	decon_to_psr_info(decon, &psr);
--- a/drivers/video/fbdev/exynos/dpu30/Kconfig
+++ b/drivers/video/fbdev/exynos/dpu30/Kconfig
@@ -151,6 +151,16 @@
         bool "Support ystrace for DPU Regression Test"
         depends on EXYNOS_DPU30
         default n
+
+config EXYNOS_DECON_BOOT_SPLASH
+	bool "Show a boot splash when the panel is handed over blank"
+	depends on EXYNOS_DPU30 && MCD_PANEL
+	default y
+	help
+	  Bootloader rev2 (R870XXS2JZG3) hands the panel over in sleep-in
+	  without its logo, so the screen stays black until the first frame
+	  of SurfaceFlinger. With this option decon draws a power symbol into
+	  its framebuffer at probe and sends it to the panel once.
 endif
 
 
-- 
2.43.0

